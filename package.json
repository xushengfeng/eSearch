{
    "name": "eSearch",
    "version": "15.4.1",
    "description": "识屏 · 搜索",
    "main": "./out/main/main.js",
    "scripts": {
        "pack": "npm run build && electron-builder --dir -c electron-builder.config.js",
        "dist": "npm run build && electron-builder -p never -c electron-builder.config.js",
        "start": "electron-vite --ignoreConfigWarning preview",
        "dev": "electron-vite --ignoreConfigWarning dev",
        "build": "electron-vite --ignoreConfigWarning build",
        "ana": "electron-vite --ignoreConfigWarning preview --mode analyze",
        "uitest": "electron-vite -c electron.vite.config_test.ts",
        "typecheck": "npx tsc -b --noEmit",
        "format": "npx biome format --write src/",
        "lint": "npx biome check src/",
        "fix": "biome check --write src/"
    },
    "author": {
        "name": "xsf",
        "email": "xushengfeng_zg@163.com"
    },
    "homepage": "https://github.com/xushengfeng/eSearch/",
    "license": "GPL-3.0",
    "packageManager": "pnpm@10.17.0",
    "dependencies": {
        "@erase2d/fabric": "^1.2.1",
        "@pdf-lib/upng": "^1.0.1",
        "@xushengfeng/fasttext_wasm": "1.0.6",
        "bmp-js": "^0.1.0",
        "chroma-js": "^3.1.1",
        "diff-match-patch": "^1.0.5",
        "diff-match-patch-line-and-word": "^0.1.3",
        "dkh-ui": "^0.14.2",
        "edge_det": "^0.1.3",
        "esearch-ocr": "8.5.2",
        "esearch-seg": "1.1.9",
        "fabric": "^7.4.0",
        "fuse.js": "^7.1.0",
        "gifenc": "^1.0.3",
        "hex-to-css-filter": "^5.4.0",
        "hotkeys-js": "^3.13.7",
        "mediabunny": "^1.14.3",
        "minimist": "^1.2.8",
        "myde-dbus": "^0.5.2",
        "node-screenshots": "^0.2.8",
        "onnxruntime-node": "^1.27.0",
        "picture_match": "^0.1.4",
        "qr-scanner-wechat": "^0.1.3",
        "remarkable": "^2.0.1",
        "uiohook-napi": "^1.5.4",
        "xtranslator": "^1.5.9",
        "yauzl": "^3.2.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.9.4",
