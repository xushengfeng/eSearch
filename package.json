        "electron-vite": "^4.0.1",
        "inquirer": "^12.7.0",
        "typescript": "^5.8.3",
        "vite": "^7.3.6",
        "vite-bundle-analyzer": "^1.2.0",
        "vite-plugin-image-optimizer": "^1.1.8",
        "vitest": "^4.1.10",
        "xtimelog": "^1.0.5"
